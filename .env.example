# Database (MySQL)
DATABASE_URL="mysql://root:rootpassword@localhost:3306/massageflow"

# Better Auth
BETTER_AUTH_SECRET="replace-with-secure-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# UploadThing
UPLOADTHING_TOKEN="replace-with-uploadthing-token"

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN="replace-with-line-channel-access-token"
LINE_CHANNEL_SECRET="replace-with-line-channel-secret"

# Seed Initial Admin Credentials
ADMIN_INITIAL_EMAIL="admin@massageflow.local"
ADMIN_INITIAL_PASSWORD="AdminPassword123!"

# Docker MySQL Configuration (used by docker-compose.yml)
MYSQL_ROOT_PASSWORD="rootpassword"
MYSQL_DATABASE="massageflow"
MYSQL_PORT="3306"
APP_PORT="3000"
